<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>NexusAndroid</RootNamespace>
    <AssemblyName>NexusAndroid</AssemblyName>
    <Version>0.22.4</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Release zips (get.ps1, .mcpb): one self-contained file per architecture, no .NET to install. -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="tool-contracts.json" LogicalName="tool-contracts.json" />
    <!-- Shared guard policy, vendored byte for byte from the common folder (vendored.sha256). -->
    <EmbeddedResource Include="garde-fous.json" LogicalName="garde-fous.json" />
    <!-- Phone-side read helper, built from phone/NexusQuery.java by phone/build.ps1. -->
    <EmbeddedResource Include="nexus-query.dex" LogicalName="nexus-query.dex" />
    <InternalsVisibleTo Include="NexusAndroid.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Antigravity plugin (guide and logo), installed by `setup` next to the server entry. -->
    <None Include="..\plugin\**\*" LinkBase="plugin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
