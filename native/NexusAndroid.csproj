<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>NexusAndroid</RootNamespace>
    <AssemblyName>NexusAndroid</AssemblyName>
    <Version>0.23.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Release zips (get.ps1, .mcpb): one self-contained file per architecture, no .NET to install. -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="tool-contracts.json" LogicalName="tool-contracts.json" />
    <!-- Shared guard policy, vendored byte for byte from the common folder (vendored.sha256). -->
    <EmbeddedResource Include="garde-fous.json" LogicalName="garde-fous.json" />
    <InternalsVisibleTo Include="NexusAndroid.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Antigravity plugin (manifest, logo, guide), installed by `setup` next to the server entry. The same plugin
         folder also serves Claude Code (.claude-plugin, .mcp.json) and Codex (.codex-plugin, .codex-mcp.json) from
         the NexusSystem catalog; those files are not shipped with the executable. -->
    <None Include="..\plugin\plugin.json;..\plugin\logo.png" LinkBase="plugin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\plugin\skills\**\*" LinkBase="plugin\skills" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Phone-side read helper: built from phone/NexusQuery.java by phone/build.ps1 (pinned, checksum-verified d8) and
       embedded, so the repository holds its source only. Rebuilt when the Java source, its stubs or the script change. -->
  <ItemGroup>
    <NexusQuerySource Include="..\phone\NexusQuery.java;..\phone\build.ps1;..\phone\stubs\**\*.java" />
  </ItemGroup>
  <Target Name="BuildNexusQueryDex" BeforeTargets="AssignTargetPaths" Inputs="@(NexusQuerySource)" Outputs="$(IntermediateOutputPath)nexus-query.dex">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\phone\build.ps1&quot; -Output &quot;$(IntermediateOutputPath)nexus-query.dex&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)nexus-query.dex" LogicalName="nexus-query.dex" />
    </ItemGroup>
  </Target>
</Project>
