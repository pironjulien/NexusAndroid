<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>NexusAndroid</RootNamespace>
    <AssemblyName>NexusAndroid</AssemblyName>
    <Version>0.20.3</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="tool-contracts.json" LogicalName="tool-contracts.json" />
    <EmbeddedResource Include="..\src\nexus_android\garde-fous.json" LogicalName="garde-fous.json" />
    <EmbeddedResource Include="..\src\nexus_android\nexus-query.dex" LogicalName="nexus-query.dex" Condition="Exists('..\src\nexus_android\nexus-query.dex')" />
  </ItemGroup>
</Project>
