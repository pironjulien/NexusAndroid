<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>NexusAndroid</RootNamespace>
    <AssemblyName>NexusAndroid</AssemblyName>
    <Version>0.25.5</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Both release architectures in the restore graph, so packages.lock.json covers the release publishes. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Native AOT: release zips (get.ps1, .mcpb) carry one NexusAndroid.exe compiled ahead of time per architecture (no
         .NET to install, no JIT at start-up). The trimming, single-file and AOT analyzers run in every build and, with
         warnings as errors, no reflection-based JSON or runtime-marshalled call can come back; reflection-based JSON is
         off in every build of the engine, so the tests run it the way the release does. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The two packages below are pinned on purpose (see there): their "delete explicit reference" notice is answered. -->
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AOT compiler and the trimmer, pinned like any package (packages.lock.json, Dependabot): left implicit, their
         version would follow the .NET SDK of the machine and break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="tool-contracts.json" LogicalName="tool-contracts.json" />
    <!-- Shared guard policy, vendored byte for byte from the common folder (vendored.sha256). -->
    <EmbeddedResource Include="garde-fous.json" LogicalName="garde-fous.json" />
    <InternalsVisibleTo Include="NexusAndroid.Tests" />
    <InternalsVisibleTo Include="NexusAndroid.Banc" />
  </ItemGroup>

  <ItemGroup>
    <!-- Antigravity plugin (manifest, logo, guide), installed by `setup` next to the server entry. The same plugin
         folder also serves Claude Code (.claude-plugin, .mcp.json) and Codex (.codex-plugin, .codex-mcp.json) from
         the NexusSystem catalog; those files are not shipped with the executable. -->
    <None Include="..\plugin\plugin.json;..\plugin\logo.png" LinkBase="plugin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\plugin\skills\**\*" LinkBase="plugin\skills" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Phone-side read helper: built from phone/NexusQuery.java by phone/build.ps1 (pinned, checksum-verified d8) and
       embedded, so the repository holds its source only. Rebuilt when the Java source, its stubs or the script change. -->
  <ItemGroup>
    <NexusQuerySource Include="..\phone\NexusQuery.java;..\phone\build.ps1;..\phone\stubs\**\*.java" />
  </ItemGroup>
  <Target Name="BuildNexusQueryDex" BeforeTargets="AssignTargetPaths" Inputs="@(NexusQuerySource)" Outputs="$(IntermediateOutputPath)nexus-query.dex">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\phone\build.ps1&quot; -Output &quot;$(IntermediateOutputPath)nexus-query.dex&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)nexus-query.dex" LogicalName="nexus-query.dex" />
    </ItemGroup>
  </Target>
</Project>
