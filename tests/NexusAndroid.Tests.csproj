<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3 on Microsoft.Testing.Platform (global.json): `dotnet test` from the repository root. Offline: every
       phone, adb and DevTools transport is a fixture; nothing is sent to a device. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>NexusAndroid.Tests</RootNamespace>
    <!-- Own entry point (Entry.cs): the test executable also acts as an argv-echo fixture for the adb process test. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!-- Test reports outside the sources too (Microsoft.Testing.Platform writes TestResults next to the project otherwise). -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --results-directory "$(NexusBuild)TestResults"</TestingPlatformCommandLineArguments>
    <NoWarn>$(NoWarn);CS8602;CS8604;CS8600;CS8618;CS8625;CS0162;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\native\NexusAndroid.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- One process, one engine: the engine keeps process-wide safety state, so test classes run one after another. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
